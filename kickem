#!/usr/bin/env python3
# SPDX-License-Identifier: AGPL-3.0-or-later
"""kickem: run a Kick firmware fork against the emulated front panel.

    ./kickem fetch [--firmware URL|PATH] [--ref REF]
    ./kickem build [--firmware URL|PATH] [--ref REF]
    ./kickem run   [--firmware URL|PATH] [--ref REF] [--mode fast|vm] [--detach] [--fresh]
                   [--probe FILE.wav] [--throttle] [--out DIR] [--no-build]
    ./kickem stop
    ./kickem status

fetch clones or updates REF of URL into the cache ($KICKEM_CACHE, else $XDG_CACHE_HOME/kickem,
else ~/.cache/kickem) and prints the checkout's path and commit. REF is a branch, a tag or a full
commit SHA. URL may also be a local repository path.

build fetches, checks that the ref has what fast mode needs, configures and builds the fork's
desktop `Kick` app and the panel (against that ref's protocol headers), and installs the Starter
Kit into the app's data paths. CPM downloads (JUCE) go to $CPM_SOURCE_CACHE, else
<cache>/cpm.

run (fast mode) builds, takes the machine-wide lock, starts the panel on a pseudo-terminal and
`Kick` from its build directory with KICK_SERIAL_DEVICE=<pty>, KICK_TEST_CONTROL=<file> and
KICK_AUDIO_INPUT=silence (unless set), and waits for the control-surface handshake in both
logs. In the foreground it runs until either program exits or Ctrl-C, then stops both.
--detach returns after the handshake and leaves them running for `kickem stop` (the checks use
this). The run's files (logs, control files, state.json) are in --out (default <cache>/run).

Only one emulator (or in-tree KT_KickEM simulator, or plain Kick) runs per machine. run holds a
lock directory ($KICKEM_LOCK, default /tmp/kt_kickem.lock, the same lock and format as the
in-tree sim_launch.sh: a directory holding the owner's pid, which is the running app's pid once
it is started; a dead owner's lock is reclaimed) and waits up to $KICKEM_LOCK_WAIT seconds
(default 1800) for another instance to quit. It also waits while a Kick or KT_KickEM process
runs without the lock.

Python 3.8+ standard library only.
"""

import argparse
import contextlib
import datetime
import fcntl
import hashlib
import json
import os
import re
import shlex
import shutil
import signal
import subprocess
import sys
import time

DEFAULT_FIRMWARE = "https://github.com/KickEm-Tools/0700-AAM.git"
DEFAULT_REF = "main"
ROOT = os.path.dirname(os.path.abspath(__file__))
IS_MAC = sys.platform == "darwin"
IS_LINUX = sys.platform.startswith("linux")

CANNOT_TELL = {
    "fast": ("fast mode runs the fork's desktop Kick app, not the device's Linux build. It cannot "
             "tell you anything Linux-specific: systemd units, scripts, device nodes, and the Wi-Fi / "
             "Ethernet / CV / firmware-update screens (shown as 'not available on this system'). "
             "Timing, latency and CPU load are the desktop's, not the unit's A53 cores."),
    "vm": ("faithful mode cannot tell you latency, CPU headroom on the A53 cores, the codec, the GPU "
           "driver, or the control-surface microcontroller's own behaviour."),
}


def say(msg):
    print("kickem: " + msg, file=sys.stderr, flush=True)


def die(msg, code=1):
    say(msg)
    sys.exit(code)


def cache_dir():
    if os.environ.get("KICKEM_CACHE"):
        return os.path.abspath(os.path.expanduser(os.environ["KICKEM_CACHE"]))
    base = os.environ.get("XDG_CACHE_HOME") or os.path.join(os.path.expanduser("~"), ".cache")
    return os.path.join(base, "kickem")


def cpm_cache():
    if os.environ.get("CPM_SOURCE_CACHE"):
        return os.path.abspath(os.path.expanduser(os.environ["CPM_SOURCE_CACHE"]))
    return os.path.join(cache_dir(), "cpm")


def git(*args, cwd=None, capture=False):
    cmd = ["git"] + list(args)
    if capture:
        return subprocess.run(cmd, cwd=cwd, check=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True).stdout.strip()
    subprocess.run(cmd, cwd=cwd, check=True)
    return ""


def slug(text, limit=40):
    s = re.sub(r"[^A-Za-z0-9._-]+", "_", text).strip("_.")
    return s[:limit] or "x"


def normalise_firmware(url):
    if url.startswith("-"):
        die("--firmware must be a URL or a path, not %r" % url, 2)
    if os.path.isdir(os.path.expanduser(url)):
        return "file://" + os.path.abspath(os.path.expanduser(url))  # file:// so --depth works
    return url


def check_ref(ref):
    # Git refs cannot hold these; a leading '-' would read as an option.
    if not ref or ref.startswith("-") or re.search(r"[\s~^:?*\[\\]|\.\.|@\{", ref):
        die("--ref %r is not a valid branch, tag or commit" % ref, 2)
    if re.fullmatch(r"[0-9a-fA-F]{7,39}", ref):
        say("note: %r looks like a short SHA; servers only serve full 40-character SHAs, "
            "so it is fetched as a branch or tag name" % ref)


def key_dirs(url, ref):
    """(<repo name>-<hash of url>, <ref>-<hash of ref>): one checkout and one build per URL and ref."""
    h = lambda s: hashlib.sha1(s.encode()).hexdigest()[:10]
    name = slug(re.sub(r"(\.git)?/*$", "", url).rsplit("/", 1)[-1])
    return "%s-%s" % (name, h(url)), "%s-%s" % (slug(ref), h(ref))


def checkout_dir(url, ref):
    a, b = key_dirs(url, ref)
    return os.path.join(cache_dir(), "firmware", a, b)


def build_root(url, ref):
    a, b = key_dirs(url, ref)
    return os.path.join(cache_dir(), "build", a, b)


@contextlib.contextmanager
def file_lock(path):
    """Serialises fetches and builds of the same checkout (they do not need the machine-wide lock)."""
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w") as f:
        fcntl.flock(f, fcntl.LOCK_EX)
        try:
            yield
        finally:
            fcntl.flock(f, fcntl.LOCK_UN)


def fetch(url, ref, force=False):
    """Clones or updates REF of URL (shallow) into the cache; returns (path, commit, url)."""
    check_ref(ref)
    url = normalise_firmware(url)
    if shutil.which("git") is None:
        die("git is not installed")
    path = checkout_dir(url, ref)
    with file_lock(path + ".lock"):
        fresh = not os.path.isdir(os.path.join(path, ".git"))
        if fresh:
            say("fetching %s %s into %s" % (url, ref, path))
            if os.path.exists(path):
                shutil.rmtree(path)  # a half-made checkout from an interrupted fetch
            os.makedirs(path)
            git("init", "--quiet", path)
            git("remote", "add", "origin", url, cwd=path)
        else:
            say("updating %s %s in %s" % (url, ref, path))
            if git("status", "--porcelain", "--untracked-files=no", cwd=path, capture=True) and not force:
                die("%s has local changes; commit them elsewhere or run fetch --force to discard them" % path)
        try:
            # Works for a branch, a tag or a full commit SHA alike; --depth 1 keeps it small.
            git("fetch", "--quiet", "--depth", "1", "--no-tags", "origin", ref, cwd=path)
        except subprocess.CalledProcessError:
            if fresh:
                shutil.rmtree(path, ignore_errors=True)
            die("cannot fetch %s from %s" % (ref, url))
        git("checkout", "--quiet", "--force", "--detach", "FETCH_HEAD", cwd=path)
        commit = git("rev-parse", "HEAD", cwd=path, capture=True)
        subject = git("log", "-1", "--format=%s", cwd=path, capture=True)
        with open(os.path.join(path, ".git", "kickem-fetch.json"), "w") as f:
            json.dump({"url": url, "ref": ref, "commit": commit,
                       "fetched": datetime.datetime.now(datetime.timezone.utc).isoformat(timespec="seconds")}, f, indent=2)
    print("firmware  %s" % url)
    print("ref       %s" % ref)
    print("commit    %s  %s" % (commit, subject))
    print("checkout  %s" % path, flush=True)
    return path, commit, url


# --- What fast mode needs in the firmware ---------------------------------------------------
# (what, file, marker, branch in KickEm-Tools/0700-AAM, required)
NEEDS = [
    ("the release build (reconstructed AudIO_juce)", "AudIO/AudIO_juce/AudIO_juce.h", None, "build/release-builds", True),
    ("a working serial port with KICK_SERIAL_DEVICE", "Kick/modules/input_events/input_events.cpp", "KICK_SERIAL_DEVICE", "feature/serialport", True),
    ("the test-control module (KICK_TEST_CONTROL), for screen commands", "Kick/apps/kick/Main.cpp", "KICK_TEST_CONTROL", "feature/desktop-seams", False),
    ("the audio probe (KICK_AUDIO_PROBE / KICK_AUDIO_INPUT), for audio checks", "AudIO/AudIO_juce/source", "KICK_AUDIO_PROBE", "feature/desktop-seams", False),
    ("the hardware probe (KICK_HARDWARE), so a Linux desktop is not reconfigured", "Kick/modules/hardware", "KICK_HARDWARE", "feature/desktop-seams", IS_LINUX),
    ("relative sample paths (the Starter Kit loads its samples)", "Kick/modules/engine/audio_engine/engine/mt_audio_manager.cpp", "resolveRelativeSamplePaths", "fix/relative-sample-paths", False),
]


def has_marker(path, marker):
    if not os.path.exists(path):
        return False
    if marker is None:
        return True
    files = [path] if os.path.isfile(path) else [os.path.join(d, f) for d, _, fs in os.walk(path) for f in fs]
    for f in files:
        try:
            with open(f, encoding="utf-8", errors="replace") as fh:
                if marker in fh.read():
                    return True
        except OSError:
            pass
    return False


def preflight(src, ignore=False):
    """Says what the ref lacks for fast mode; stops when something required is missing."""
    missing_required = []
    for what, rel, marker, branch, required in NEEDS:
        if not has_marker(os.path.join(src, rel), marker):
            say("%s: this ref lacks %s (%s in %s; KickEm-Tools/0700-AAM branch %s)"
                % ("MISSING" if required else "missing", what, marker or "the file", rel, branch))
            if required:
                missing_required.append(branch)
    if missing_required and not ignore:
        die("fast mode cannot run this ref: it needs %s. Pass --ignore-missing to try anyway."
            % ", ".join(sorted(set(missing_required))), 4)


# --- Building ---------------------------------------------------------------------------------
def build_env():
    env = dict(os.environ)
    if IS_MAC:
        env.setdefault("MACOSX_DEPLOYMENT_TARGET", "12.0")  # JUCE's nested juceaide build needs it
    env["CPM_SOURCE_CACHE"] = cpm_cache()
    return env


def run_logged(cmd, log, cwd=None, env=None):
    say("$ " + " ".join(shlex.quote(c) for c in cmd))
    with open(log, "a") as f:
        f.write("\n$ %s\n" % " ".join(shlex.quote(c) for c in cmd))
        f.flush()
        p = subprocess.run(cmd, cwd=cwd, env=env, stdout=f, stderr=subprocess.STDOUT)
    if p.returncode != 0:
        with open(log, errors="replace") as f:
            tail = f.readlines()[-25:]
        sys.stderr.write("".join(tail))
        die("failed (exit %d), full log: %s" % (p.returncode, log))


def jobs():
    return str(os.cpu_count() or 4)


def kick_app(kick_build):
    if IS_MAC:
        return os.path.join(kick_build, "Kick.app", "Contents", "MacOS", "Kick")
    for c in ("apps/kick/Kick_artefacts/Release/Kick", "apps/kick/Kick_artefacts/Kick"):
        if os.path.exists(os.path.join(kick_build, c)):
            return os.path.join(kick_build, c)
    return os.path.join(kick_build, "apps/kick/Kick_artefacts/Release/Kick")


def panel_app(panel_build):
    return os.path.join(panel_build, "panel", "kickem-panel")


def build_firmware(src, kick_build, log):
    env = build_env()
    os.makedirs(kick_build, exist_ok=True)
    if not os.path.exists(os.path.join(kick_build, "CMakeCache.txt")):
        run_logged(["cmake", "-S", os.path.join(src, "Kick"), "-B", kick_build, "-DCMAKE_BUILD_TYPE=Release",
                    "-DTIMESTAMP=OFF", "-DCPM_SOURCE_CACHE=" + env["CPM_SOURCE_CACHE"]], log, env=env)
    run_logged(["cmake", "--build", kick_build, "--target", "Kick", "-j", jobs()], log, env=env)
    if not os.path.exists(kick_app(kick_build)):
        die("the build finished but %s is missing" % kick_app(kick_build))


def build_panel(src, panel_build, log):
    env = build_env()
    os.makedirs(panel_build, exist_ok=True)
    if not os.path.exists(os.path.join(panel_build, "CMakeCache.txt")):
        run_logged(["cmake", "-S", ROOT, "-B", panel_build, "-DCMAKE_BUILD_TYPE=Release",
                    "-DKICKEM_FIRMWARE_DIR=" + src, "-DKICKEM_PROTOCOL_JUCE=juce",
                    "-DCPM_SOURCE_CACHE=" + env["CPM_SOURCE_CACHE"]], log, env=env)
    run_logged(["cmake", "--build", panel_build, "--target", "kickem-panel", "-j", jobs()], log, env=env)


def copytree(src, dst):
    os.makedirs(dst, exist_ok=True)
    for d, _, files in os.walk(src):
        rel = os.path.relpath(d, src)
        os.makedirs(os.path.join(dst, rel), exist_ok=True)
        for f in files:
            if f in ("make_starter_kit.py", ".DS_Store"):
                continue
            shutil.copy2(os.path.join(d, f), os.path.join(dst, rel, f))


def install_content(src, kick_build, fresh=False):
    """The Starter Kit into the data paths the app resolves from its working directory
    (content/StarterKit/README.md has the map). fresh: first restore demos/ and templates/ from
    the checkout and drop prefs/, so a previous run's saves or recent projects do not leak in."""
    kit = os.path.join(ROOT, "content", "StarterKit")
    if fresh:
        for d in ("demos", "templates"):
            shutil.rmtree(os.path.join(kick_build, d), ignore_errors=True)
            if os.path.isdir(os.path.join(src, "Kick", d)):
                shutil.copytree(os.path.join(src, "Kick", d), os.path.join(kick_build, d))
        shutil.rmtree(os.path.join(kick_build, "prefs"), ignore_errors=True)
    for dst in ("assets/StarterKit", "data/samplesKick/StarterKit"):
        copytree(os.path.join(kit, "samples"), os.path.join(kick_build, dst))
    copytree(os.path.join(kit, "demos", "Starter Kit"), os.path.join(kick_build, "demos", "Starter Kit"))
    os.makedirs(os.path.join(kick_build, "assets", "Default", "recent_project"), exist_ok=True)
    shutil.copy2(os.path.join(kit, "recent_project", "Starter Kit.png"),
                 os.path.join(kick_build, "assets", "Default", "recent_project", "Starter Kit.png"))
    say("Starter Kit installed into %s (assets/StarterKit, data/samplesKick/StarterKit, demos/Starter Kit, "
        "assets/Default/recent_project)%s" % (kick_build, "; demos, templates and prefs fresh" if fresh else ""))


def use_checkout(url, ref):
    """--no-fetch: the cached checkout as it is, local edits included."""
    check_ref(ref)
    url = normalise_firmware(url)
    path = checkout_dir(url, ref)
    if not os.path.isdir(os.path.join(path, ".git")):
        die("--no-fetch: no checkout of %s %s yet in %s; run without --no-fetch once" % (url, ref, path))
    commit = git("rev-parse", "HEAD", cwd=path, capture=True)
    dirty = git("status", "--porcelain", "--untracked-files=no", cwd=path, capture=True)
    if dirty:
        commit += "+local"
        say("--no-fetch: using %s with local changes:\n%s" % (path, dirty))
    print("firmware  %s" % url)
    print("ref       %s" % ref)
    print("commit    %s" % commit)
    print("checkout  %s" % path, flush=True)
    return path, commit, url


def build(a):
    if getattr(a, "no_fetch", False):
        path, commit, url = use_checkout(a.firmware, a.ref)
    else:
        path, commit, url = fetch(a.firmware, a.ref, force=a.force)
    preflight(path, a.ignore_missing)
    root = build_root(url, a.ref)
    kick_build, panel_build = os.path.join(root, "kick"), os.path.join(root, "panel")
    os.makedirs(root, exist_ok=True)
    log = os.path.join(root, "build.log")
    with file_lock(root + ".lock"):
        if a.no_build and os.path.exists(kick_app(kick_build)) and os.path.exists(panel_app(panel_build)):
            say("--no-build: using %s" % root)
        else:
            t0 = time.monotonic()
            first = not os.path.exists(kick_app(kick_build))
            say("building the firmware's Kick app in %s (log %s)" % (kick_build, log))
            build_firmware(path, kick_build, log)
            t1 = time.monotonic()
            say("building the panel in %s" % panel_build)
            build_panel(path, panel_build, log)
            t2 = time.monotonic()
            say("built in %.0f s (Kick %.0f s, panel %.0f s)%s" % (t2 - t0, t1 - t0, t2 - t1, ", first build" if first else ""))
            with open(os.path.join(root, "build-times.json"), "a") as f:
                f.write(json.dumps({"commit": commit, "first": first, "kick_s": round(t1 - t0, 1),
                                    "panel_s": round(t2 - t1, 1), "at": time.time()}) + "\n")
        install_content(path, kick_build, fresh=getattr(a, "fresh", False))
    print("kick      %s" % kick_app(kick_build))
    print("panel     %s" % panel_app(panel_build), flush=True)
    return path, commit, url, kick_build, panel_build


# --- Machine-wide lock (same lock and format as sim_launch.sh) -------------------------------
LOCK = os.environ.get("KICKEM_LOCK") or os.environ.get("KICK_SIM_LOCK") or "/tmp/kt_kickem.lock"
APP_NAMES = ("Kick", "KT_KickEM")


def alive(pid):
    if not pid:
        return False
    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True


def lock_owner():
    try:
        with open(os.path.join(LOCK, "pid")) as f:
            return int(f.read().strip() or 0)
    except (OSError, ValueError):
        return 0


def running_apps():
    """Pids of Kick / KT_KickEM processes on this machine (the app allows one instance)."""
    pids = []
    for name in APP_NAMES:
        try:
            out = subprocess.run(["pgrep", "-x", name], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True).stdout
        except FileNotFoundError:
            return []
        pids += [int(p) for p in out.split()]
    return pids


def acquire_lock(wait=None):
    """Takes the machine-wide lock, waiting for another instance to quit. Owner: this process."""
    wait = int(os.environ.get("KICKEM_LOCK_WAIT", "1800")) if wait is None else wait
    waited, ownerless_since = 0, None
    while True:
        try:
            os.mkdir(LOCK)
            with open(os.path.join(LOCK, "pid"), "w") as f:
                f.write("%d\n" % os.getpid())
            others = running_apps()
            if not others:
                return
            shutil.rmtree(LOCK, ignore_errors=True)  # someone runs Kick without the lock; wait for it
            if waited == 0:
                say("a Kick / KT_KickEM process runs without the lock (pid %s); waiting for it to quit"
                    % ", ".join(map(str, others)))
        except FileExistsError:
            owner = lock_owner()
            if owner and not alive(owner):
                say("reclaiming the lock of dead pid %d" % owner)
                shutil.rmtree(LOCK, ignore_errors=True)
                continue
            if not owner:
                # A launcher between mkdir and writing its pid; give it 30 s, as sim_launch.sh does.
                ownerless_since = ownerless_since if ownerless_since is not None else waited
                if waited - ownerless_since >= 30 and not running_apps():
                    shutil.rmtree(LOCK, ignore_errors=True)
                    continue
            if waited == 0:
                say("waiting for another emulator to quit (lock %s, pid %s)..." % (LOCK, lock_owner() or "?"))
        if waited >= wait:
            die("another emulator (lock %s, pid %s) is still running after %d s" % (LOCK, lock_owner() or "?", wait))
        time.sleep(5)
        waited += 5


def set_lock_owner(pid):
    with open(os.path.join(LOCK, "pid"), "w") as f:
        f.write("%d\n" % pid)


def release_lock(pids):
    if lock_owner() in pids:
        shutil.rmtree(LOCK, ignore_errors=True)


# --- Running (fast mode) -----------------------------------------------------------------------
def run_dir(a):
    return os.path.abspath(a.out) if getattr(a, "out", None) else os.path.join(cache_dir(), "run")


def state_path(d):
    return os.path.join(d, "state.json")


def read_state(d):
    try:
        with open(state_path(d)) as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def write_state(d, st):
    with open(state_path(d), "w") as f:
        json.dump(st, f, indent=2)


def wait_for(path, pattern, timeout, pids=()):
    """Waits until a line of PATH matches PATTERN; returns the match, or None if a pid died / timeout."""
    rx = re.compile(pattern)
    end = time.monotonic() + timeout
    while time.monotonic() < end:
        try:
            with open(path, errors="replace") as f:
                for line in f:
                    m = rx.search(line)
                    if m:
                        return m
        except OSError:
            pass
        for p in pids:
            reap(p)
            if not alive(p):
                return None
        time.sleep(0.1)
    return None


def reap(pid):
    try:
        os.waitpid(pid, os.WNOHANG)
    except (ChildProcessError, OSError):
        pass


def stop_pid(pid, name, timeout=10.0):
    if not alive(pid):
        return
    try:
        os.kill(pid, signal.SIGTERM)
    except ProcessLookupError:
        return
    end = time.monotonic() + timeout
    while time.monotonic() < end:
        reap(pid)
        if not alive(pid):
            return
        time.sleep(0.1)
    say("%s (pid %d) did not quit; killing it" % (name, pid))
    try:
        os.kill(pid, signal.SIGKILL)
    except ProcessLookupError:
        pass
    reap(pid)


def stop_run(d, quiet=False):
    st = read_state(d)
    if not st:
        if not quiet:
            say("nothing to stop (no %s)" % state_path(d))
        return 0
    stop_pid(st.get("kick_pid", 0), "Kick")
    stop_pid(st.get("panel_pid", 0), "panel")
    release_lock((st.get("kick_pid", 0), st.get("panel_pid", 0), st.get("launcher_pid", 0)))
    st["stopped"] = time.time()
    write_state(d, st)
    if not quiet:
        say("stopped Kick (pid %s) and the panel (pid %s)" % (st.get("kick_pid"), st.get("panel_pid")))
    return 0


def cmd_run(a):
    say("mode %s. What it cannot tell you: %s" % (a.mode, CANNOT_TELL[a.mode]))
    if a.mode == "vm":
        path, _, _ = fetch(a.firmware, a.ref, force=a.force)
        die("--mode vm (faithful mode) comes in phase 6 of /goal-standalone; the checkout is ready "
            "for -DKICKEM_FIRMWARE_DIR=%s" % path, 3)
    t_start = time.monotonic()
    path, commit, url, kick_build, panel_build = build(a)
    t_built = time.monotonic()

    d = run_dir(a)
    os.makedirs(d, exist_ok=True)
    old = read_state(d)
    if old and alive(old.get("panel_pid", 0)) and not alive(old.get("kick_pid", 0)):
        stop_pid(old["panel_pid"], "the previous run's panel")

    acquire_lock()
    started = []  # (pid, name) of what this call started and has not handed over
    try:
        panel_log, kick_log = os.path.join(d, "panel.log"), os.path.join(d, "kick.log")
        panel_ctl, test_ctl = os.path.join(d, "panel.ctl"), os.path.join(d, "test.ctl")
        for f in (panel_ctl, test_ctl):
            if os.path.exists(f) and not os.path.isfile(f):
                os.remove(f)  # never block on a stale FIFO
            open(f, "w").close()

        # The panel, on a new pseudo-terminal.
        cmd = [panel_app(panel_build), "--transport", a.transport, "--control", panel_ctl]
        if a.throttle:
            cmd += ["--throttle", str(a.throttle)]
        say("starting the panel: " + " ".join(shlex.quote(c) for c in cmd))
        with open(panel_log, "w") as lf:
            panel = subprocess.Popen(cmd, stdout=lf, stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL,
                                     cwd=d, start_new_session=True)
        started.append((panel.pid, "panel"))
        set_lock_owner(panel.pid)
        m = wait_for(panel_log, r"SimSerial: (?:listening on|connected to|opened) (\S+)", 20, [panel.pid])
        if not m:
            say("the panel did not open its transport, see %s" % panel_log)
            return 1
        device = m.group(1)

        # The firmware's desktop app, from its build directory (it resolves its data from there).
        env = dict(os.environ)
        env["KICK_SERIAL_DEVICE"] = device
        env["KICK_TEST_CONTROL"] = test_ctl
        env.setdefault("KICK_AUDIO_INPUT", "silence")  # never a path from the microphone to the speakers
        if a.probe:
            env["KICK_AUDIO_PROBE"] = os.path.abspath(a.probe)
        if IS_LINUX:
            env.setdefault("KICK_HARDWARE", "none")  # never ifconfig / timedatectl on this computer
        app = kick_app(kick_build)
        shown = {k: env[k] for k in ("KICK_SERIAL_DEVICE", "KICK_TEST_CONTROL", "KICK_AUDIO_INPUT",
                                     "KICK_AUDIO_PROBE", "KICK_HARDWARE", "KICK_LOG_NOTES") if k in env}
        say("starting Kick: cd %s && %s %s" % (kick_build, " ".join("%s=%s" % kv for kv in shown.items()), app))
        with open(kick_log, "w") as lf:
            kick = subprocess.Popen([app], stdout=lf, stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL,
                                    cwd=kick_build, env=env, start_new_session=True)
        started.append((kick.pid, "Kick"))
        set_lock_owner(kick.pid)
        st = {"mode": a.mode, "firmware": url, "ref": a.ref, "commit": commit, "kick_build": kick_build,
              "panel_build": panel_build, "kick_pid": kick.pid, "panel_pid": panel.pid,
              "launcher_pid": os.getpid(), "device": device, "kick_log": kick_log, "panel_log": panel_log,
              "panel_control": panel_ctl, "test_control": test_ctl, "probe": env.get("KICK_AUDIO_PROBE"),
              "started": time.time(), "build_s": round(t_built - t_start, 1)}
        write_state(d, st)

        ok = wait_for(kick_log, r"Send Comm Live", 90, [kick.pid, panel.pid])
        live = ok and wait_for(panel_log, r"SimSerial: LIVE", 10, [kick.pid, panel.pid])
        if not live:
            say("no control-surface handshake; see %s and %s" % (kick_log, panel_log))
            return 1
        t_live = time.monotonic()
        st["live_s"] = round(t_live - t_built, 1)
        write_state(d, st)
        say("handshake LIVE %.1f s after the build (%.1f s since kickem started)" % (t_live - t_built, t_live - t_start))
        print("device    %s" % device)
        print("kick log  %s" % kick_log)
        print("panel log %s" % panel_log)
        print("state     %s" % state_path(d), flush=True)
        if a.detach:
            started.clear()  # left running for `kickem stop`
            return 0

        say("running; Ctrl-C (or quitting either program) stops both")
        stopping = []
        signal.signal(signal.SIGTERM, lambda *_: stopping.append(1))
        try:
            while not stopping and alive(kick.pid) and alive(panel.pid):
                reap(kick.pid)
                reap(panel.pid)
                time.sleep(0.5)
        except KeyboardInterrupt:
            pass
        return 0
    finally:
        for pid, name in reversed(started):
            stop_pid(pid, name)
        if started:
            release_lock([os.getpid()] + [p for p, _ in started])
        elif lock_owner() == os.getpid():
            release_lock([os.getpid()])


def cmd_fetch(a):
    fetch(a.firmware, a.ref, force=a.force)
    return 0


def cmd_build(a):
    build(a)
    return 0


def cmd_stop(a):
    return stop_run(run_dir(a))


def cmd_status(a):
    st = read_state(run_dir(a))
    if not st:
        say("no run in %s" % run_dir(a))
        return 1
    for k in ("firmware", "ref", "commit", "device", "kick_pid", "panel_pid", "kick_log", "panel_log"):
        extra = ""
        if k.endswith("_pid"):
            extra = " (running)" if alive(st.get(k, 0)) else " (gone)"
        print("%-11s %s%s" % (k, st.get(k), extra))
    print("lock        %s pid %s" % (LOCK, lock_owner() or "-"))
    return 0


def main(argv=None):
    p = argparse.ArgumentParser(prog="kickem", description="Run a Kick firmware fork against the emulated front panel.")
    sub = p.add_subparsers(dest="command", required=True)

    def common(sp):
        sp.add_argument("--firmware", default=DEFAULT_FIRMWARE, metavar="URL", help="firmware git URL or local repository (default: %(default)s)")
        sp.add_argument("--ref", default=DEFAULT_REF, help="branch, tag or full commit SHA (default: %(default)s)")
        sp.add_argument("--force", action="store_true", help="discard local changes in the cached checkout")

    def building(sp):
        sp.add_argument("--no-build", action="store_true", help="skip the build when both programs exist")
        sp.add_argument("--no-fetch", action="store_true", help="use the cached checkout as it is, local edits included")
        sp.add_argument("--ignore-missing", action="store_true", help="build even if the ref lacks what fast mode needs")
        sp.add_argument("--fresh", action="store_true", help="restore demos/ and templates/ and drop prefs/ in the build")

    f = sub.add_parser("fetch", help="clone or update the firmware ref into the cache")
    common(f)
    f.set_defaults(func=cmd_fetch)

    b = sub.add_parser("build", help="fetch and build the firmware's desktop Kick and the panel; install the Starter Kit")
    common(b)
    building(b)
    b.set_defaults(func=cmd_build)

    r = sub.add_parser("run", help="fetch, build and run the firmware against the panel")
    common(r)
    building(r)
    r.add_argument("--mode", choices=("fast", "vm"), default="fast", help="fast: desktop build over a pty; vm: Linux arm64 in QEMU (default: %(default)s)")
    r.add_argument("--detach", action="store_true", help="return once the handshake is LIVE; stop with `kickem stop`")
    r.add_argument("--probe", metavar="FILE.wav", help="KICK_AUDIO_PROBE: write the master output there, log AudioProbe: lines")
    r.add_argument("--throttle", type=int, nargs="?", const=230400, default=0, metavar="BAUD", help="pace the panel's link at the unit's UART rate (default 230400)")
    r.add_argument("--transport", default="pty", help="panel transport: pty, tcp:HOST:PORT, serial:DEV[@BAUD] (default: pty)")
    r.add_argument("--out", help="directory for the run's logs, control files and state (default: <cache>/run)")
    r.set_defaults(func=cmd_run)

    for name, fn, hlp in (("stop", cmd_stop, "stop the running Kick and panel, release the lock"),
                          ("status", cmd_status, "show the current run")):
        s = sub.add_parser(name, help=hlp)
        s.add_argument("--out", help="the run directory (default: <cache>/run)")
        s.set_defaults(func=fn)

    a = p.parse_args(argv)
    return a.func(a)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
