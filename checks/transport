#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-or-later
#
# Transport keys, BAR:BEAT:TICK, gain staging, RECORD / OVERDUB, TAP TEMPO and the metronome on
# the Starter Kit, over the wire. Port of the in-tree simulator's sim_transport.sh (work-branch
# docs/DEVELOPMENT.md 4.7) with the same assertions and thresholds.
#
#   checks/transport [--firmware URL|PATH] [--ref REF] [--no-build] [--no-fetch] [OUTDIR]
#
# Default OUTDIR: checks/out/transport. Exit status 1 if any check fails. Evidence: kick.log,
# panel.log, probe.wav, events.txt and screenshots. About 2.5 minutes after the build.
#
#   A  Pad 1 once; PLAY START, STOP, PLAY (resumes), STOP, PLAY START (from the top), STOP.
#   B  Mute Keys and Loops; RECORD, PLAY START, three pad hits, one more pass, STOP; then
#      Timing Correct on (ON/OFF), OVERDUB, PLAY START, two more hits, one more pass, STOP.
#   C  PLAY START, four TAP TEMPO presses 600 ms apart (100 BPM), two passes at the new tempo.
#   D  Mute Drums; metronome ENABLE On, PLAY START for two bars; ENABLE Off, PLAY START again.
#
# Needs in the firmware: feature/desktop-seams (test control, probe, KICK_LOG_NOTES),
# fix/relative-sample-paths, fix/engine-gain-staging (levels), fix/sequencer-timing (PLAY START,
# tick 0), feature/note-recording (RECORD / OVERDUB), feature/timing-correct, feature/key-handlers
# (TAP TEMPO), feature/metronome (clicks and accent). Needs python3 with numpy.
#
# Ported differences: the record mode is read from the engine's "Record: armed for ..." and
# "Record: take on track ..." lines, because the firmware's status line has no record mode yet
# (rec=n/a); LED packets come from the panel's side of the wire (SimSurface: in panel.log).
set -u
NAME=transport
. "$(dirname "$0")/lib/common.sh"
parse_args "$@"
banner
EV="$OUT/events.txt"
: > "$EV"
rm -f "$OUT"/*.png

mark() { echo "$1 $(at)" >> "$EV"; "$CTL" echo "MARK $1" >/dev/null; }   # event time on the probe
st() { echo "status $1 $("$CTL" status)" >> "$EV"; }                       # engine transport status
key() { "$CTL" press "$@" >/dev/null; }
metronome_dialog() {   # the top bar's Metronome button opens METRONOME; retry until ENABLE shows
    for i in 1 2 3 4; do
        "$CTL" click Metronome >/dev/null; sleep 1
        "$CTL" list ENABLE | grep -q ENABLE && return 0
        sleep 1
    done
    echo "transport: the METRONOME dialog did not open" >&2; return 1
}

trap stop_emulator EXIT
trap 'exit 1' INT TERM
KICK_LOG_NOTES=1 KICK_AUDIO_INPUT=silence start_emulator
key PUSH                                            # Projects: load "Starter Kit" (first tile)
wait_loaded 'Project: loaded .*/Starter Kit' 2 || { echo "FAIL  Starter Kit did not load"; exit 1; }

#### A: levels, STOP / PLAY / PLAY START ###################################################
mark pad1; key "Pad 1"; sleep 1.5
mark playstart1; key "PLAY START"; sleep 5.2
key STOP; mark stop1; sleep 0.5; st stop1
"$CTL" shot "$OUT/A1-stopped.png" >/dev/null; sleep 1; st stop1b
key PLAY; mark play; sleep 0.8; st play
"$CTL" shot "$OUT/A2-resumed.png" >/dev/null; sleep 4
key STOP; mark stop2; sleep 1; st stop2
"$CTL" echo playstart2 >/dev/null; key "PLAY START"; mark playstart2; sleep 0.8; st playstart2
"$CTL" shot "$OUT/A3-playstart.png" >/dev/null; sleep 8.5
key STOP; mark stop3; sleep 2; mark quiet

#### B: RECORD and OVERDUB into the Drums track ############################################
"$CTL" tap 867 336 >/dev/null; "$CTL" tap 867 452 >/dev/null; sleep 0.5   # mute Keys and Loops (Track tab "M")
mark rec_arm; key RECORD; sleep 0.3; st armed
mark rec_start; key "PLAY START"; sleep 1.0; st recording
key "Pad 2"; sleep 1.3; key "Pad 1"; sleep 1.7; key "Pad 5"
sleep 13                                            # rest of pass 1 and all of pass 2
"$CTL" shot "$OUT/B1-recorded.png" >/dev/null
key STOP; mark rec_stop; sleep 1; st rec_stopped
key ON/OFF; sleep 0.5                               # Timing Correct on (SHIFT + TC): OVERDUB hits snap to 1/16
mark od_arm; key OVERDUB; sleep 0.3; st od_armed
mark od_start; key "PLAY START"; sleep 2.2
key "Pad 13"; sleep 3.4; key "Pad 4"
sleep 13
key STOP; mark od_stop; sleep 1; st od_stopped
key ON/OFF; sleep 0.5                               # Timing Correct off
"$CTL" shot "$OUT/B2-overdubbed.png" >/dev/null

#### C: TAP TEMPO ##########################################################################
mark tap_play; key "PLAY START"; sleep 1
mark taps; "$CTL" repeat 600 4 "TAP TEMPO" >/dev/null; st tapped
i=0; until "$CTL" status | grep -q "clock=100"; do i=$((i + 1)); [ $i -gt 40 ] && break; sleep 0.1; done
mark clock100; sleep 20
key STOP; mark tap_stop; sleep 1
"$CTL" tap 76 108 >/dev/null; sleep 0.8               # Sequence tab: shows the BPM
"$CTL" shot "$OUT/C1-tempo.png" >/dev/null
"$CTL" tap 213 108 >/dev/null; sleep 0.5              # back to the Track tab

#### D: metronome ##########################################################################
"$CTL" tap 867 220 >/dev/null; sleep 0.5              # mute Drums: only the click is left
metronome_dialog
"$CTL" clickat ENABLE 0.75 0.6 >/dev/null; sleep 0.3  # ENABLE On (MODE PLAY, RATE 1/4)
"$CTL" shot "$OUT/D1-metronome-on.png" >/dev/null
"$CTL" click Close >/dev/null; sleep 0.5; st met_on
mark met_on; key "PLAY START"; sleep 5.2
key STOP; mark met_on_stop; sleep 1
metronome_dialog
"$CTL" clickat ENABLE 0.25 0.6 >/dev/null; sleep 0.3  # ENABLE Off
"$CTL" click Close >/dev/null; sleep 0.5; st met_off
mark met_off; key "PLAY START"; sleep 3
key STOP; mark met_off_stop; sleep 1
mark end
if alive; then echo "PASS  Kick still running (pid $KPID)"; ALIVE=0; else echo "FAIL  Kick exited (crash?)"; ALIVE=1; fi
stop_emulator
trap - EXIT

#### Analysis ##############################################################################
python3 - "$OUT" "$CHECKS/lib" <<'EOF'
import re, sys
out, lib = sys.argv[1], sys.argv[2]
import numpy as np
src = open(lib + '/wav_measure.py').read().replace('\nmain()\n', '\n')
wm = {}
exec(compile(src, 'wav_measure', 'exec'), wm)
x, sr = wm['read_wav'](out + '/probe.wav')
log = open(out + '/kick.log', errors='replace').read().splitlines()
plog = open(out + '/panel.log', errors='replace').read().splitlines()
ev, status = {}, {}
for line in open(out + '/events.txt'):
    p = line.split()
    if p[0] == 'status':
        status[p[1]] = ' '.join(p[2:])
    else:
        ev[p[0]] = float(p[1])

fails = []
def check(ok, what):
    print(('PASS  ' if ok else 'FAIL  ') + what)
    if not ok:
        fails.append(what)

db = lambda v: 20 * np.log10(max(v, 1e-6))
def seg(a, b):
    return x[int(a * sr):int(b * sr)]
def peak(a, b, ch=None):
    s = seg(a, b)
    return db(np.max(np.abs(s if ch is None else s[:, ch]))) if len(s) else -120.0
def onsets(a, b, thr_db=-40, quiet=0.05):
    s = np.max(np.abs(seg(a, b)), axis=1)
    on, last = [], -10 ** 9
    for i in np.nonzero(s > 10 ** (thr_db / 20))[0]:
        if i - last > quiet * sr:
            on.append(a + i / sr)
        last = i
    return on
def freq(t):
    w = x[int(t * sr):int((t + 0.04) * sr)].mean(axis=1)
    spec = np.abs(np.fft.rfft(w * np.hanning(len(w)), 8192))
    return np.argmax(spec) * sr / 8192
def ticks(name):
    m = re.search(r'bbt=(\d+):(\d+):(\d+)', status.get(name, ''))
    return None if not m else (int(m[1]) - 1) * 384 + (int(m[2]) - 1) * 96 + int(m[3])
def between(lines, a, b):
    """Lines after the marker MARK a and before MARK b (either log)."""
    out, on = [], False
    for l in lines:
        if l.endswith(': echo MARK ' + a):
            on = True
        elif l.endswith(': echo MARK ' + b) and on:
            break
        elif on:
            out.append(l)
    return out

print('== A: levels and transport')
for k in ('stop1', 'stop1b', 'play', 'stop2', 'playstart2'):
    print(f'      status {k:11s} {status.get(k)}')
l, r = peak(ev['pad1'], ev['pad1'] + 1.4, 0), peak(ev['pad1'], ev['pad1'] + 1.4, 1)
print(f'      Pad 1 (kick, sample peak -1.0 dBFS, velocity 100, track and program level 100): left {l:.2f} dBFS, right {r:.2f} dBFS')
check(abs(l - r) < 0.5 and -15.0 < l < -11.5, 'Pad 1 is centred and about -13.3 dBFS (-1 sample, -2.1 velocity 100, -2.1 track level 100, -2.1 program level 100, -3 voice pan law, -3 program pan law)')
pk = peak(ev['playstart2'], ev['stop3'])
print(f'      sequence playback (PLAY START to STOP, {ev["stop3"] - ev["playstart2"]:.1f} s): master peak {pk:.2f} dBFS')
check(pk <= -0.5, 'playback does not clip (peak <= -0.5 dBFS)')
check(status.get('stop1') is not None and ticks('stop1') == ticks('stop1b'), 'BAR:BEAT:TICK holds after STOP')
d = (ticks('play') or 0) - (ticks('stop1') or 0)
check(bool(ticks('stop1')) and 96 <= d <= 600, f'PLAY resumes from the stopped position ({status["stop1"].split()[1]} -> {status["play"].split()[1]}, +{d} ticks)')
check(ticks('playstart2') is not None and ticks('playstart2') < 384, f'PLAY START plays from the top, not from the stopped position ({status["stop2"].split()[1]} -> {status["playstart2"].split()[1]} 0.8 s after the key)')
i_ps = next(i for i, l in enumerate(log) if l.startswith('TestControl: echo playstart2'))
first = next((l for l in log[i_ps:] if l.startswith('Note:')), '')
check(' tick 0 ' in first, f'the first note after PLAY START is on tick 0 ({first.strip()[:60]})')
q = peak(ev['stop3'] + 0.1, ev['quiet'])
print(f'      after STOP: peak {q:.1f} dBFS from 0.1 s to {ev["quiet"] - ev["stop3"]:.1f} s')
check(q < -100, 'STOP silences the output')
leds = [l for l in plog if l.startswith('SimSurface: LED cmd=0 data=4')]
check(any('data=45,1,1' in l for l in leds) and any('data=44,1,1' in l for l in leds), 'PLAY and STOP LEDs over the wire (SimSurface: LED cmd=0 data=45,1,1 / 44,1,1)')

print('== B: RECORD and OVERDUB')
for k in ('armed', 'recording', 'rec_stopped', 'od_armed', 'od_stopped'):
    print(f'      status {k:11s} {status.get(k)}')
armed = between(log, 'rec_arm', 'rec_start')
started = between(log, 'rec_start', 'rec_stop')
check(any(l == 'Record: armed for RECORD' for l in armed) and not any(l.startswith('Record: take') for l in armed)
      and any(l.startswith("Record: take on track 'Drums' (RECORD, replace)") for l in started),
      'RECORD arms while stopped; PLAY START starts the take (Record: armed for RECORD, then Record: take on track \'Drums\')')
check(any('LED cmd=0 data=42,1' in l for l in plog) and any('LED cmd=0 data=42,0' in l for l in plog), 'RECORD LED on when armed, off after STOP (LED 42)')
check(any('LED cmd=0 data=43,1' in l for l in plog), 'OVERDUB LED on when armed (LED 43)')
rec = [l for l in log if l.startswith('Record:')]
for l in rec:
    print('      ' + l)
period = 8.0                                                    # 4 bars at 120 BPM
a = ev['rec_start']
p1 = [t for t in onsets(a, a + period) if t > a + 0.3]
p2 = [t for t in onsets(a + period, a + 2 * period)]
print(f'      RECORD pass 1 onsets (live hits): {" ".join(f"{t - a:.4f}" for t in p1)} s after PLAY START')
print(f'      RECORD pass 2 onsets (sequenced): {" ".join(f"{t - a:.4f}" for t in p2)}')
d = [min((abs(t2 - t1 - period), t2 - t1) for t2 in p2)[1] for t1 in p1] if p2 else []
print(f'      pass 2 - pass 1: {" ".join(f"{v:.4f}" for v in d)} s (one loop = {period:.3f} s)')
check(len(p1) == 3 and len(p2) == 3 and all(abs(v - period) < 0.016 for v in d),
      'the three RECORD hits play back on the next pass one loop later (within 16 ms: 1 tick = 5.2 ms + one 10 ms block)')
take_end = [l for l in rec if 'ended' in l]
check(len(take_end) >= 1 and '3 notes' in take_end[0], 'RECORD replaced the track: after the take the Drums track holds only the 3 recorded notes')
a = ev['od_start']
q1 = [t for t in onsets(a, a + period) if t > a + 0.05]
q2 = onsets(a + period, a + 2 * period)
print(f'      OVERDUB pass 1 onsets: {" ".join(f"{t - a:.4f}" for t in q1)}')
print(f'      OVERDUB pass 2 onsets: {" ".join(f"{t - a:.4f}" for t in q2)}')
check(len(take_end) >= 2 and '5 notes' in take_end[1] and '0 old notes erased' in take_end[1], 'OVERDUB added 2 notes and erased none (5 notes)')
check(len(q2) == 5, 'the next pass plays all 5 recorded hits')
od_i = next((i for i, l in enumerate(rec) if '(OVERDUB)' in l), None)
od = rec[od_i:] if od_i is not None else []
od_notes = [int(re.search(r'at tick (\d+)', l)[1]) for l in od if l.startswith('Record: note')]
check(len(od_notes) == 2 and all(t % 24 == 0 for t in od_notes) and any('timing corrected' in l for l in od),
      f'with Timing Correct on, OVERDUB note starts snap to the 1/16 grid (ticks {od_notes})')

print('== C: TAP TEMPO')
for l in log:
    if l.startswith('TapTempo:'):
        print('      ' + l)
for l in plog:
    if l.startswith('PanelControl: repeat TAP'):
        print('      ' + l)
print(f'      status after the taps: {status.get("tapped")}')
check('bpm=100' in status.get('tapped', ''), 'four taps 600 ms apart set 100 BPM')
a = ev['clock100'] + 0.1
on = onsets(a, ev['tap_stop'])
new_period = 4 * 4 * 60 / 100.0                                 # 4 bars at 100 BPM = 9.6 s
pairs = [(t, u - t) for t in on for u in on if abs(u - t - new_period) < 0.05]
print(f'      onsets after the tempo change: {len(on)}; repeats one loop later: ' + ' '.join(f'{v:.4f}' for _, v in pairs))
check(len(pairs) >= 4 and all(abs(v - new_period) < 0.016 for _, v in pairs), f'the loop now repeats every {new_period:.1f} s (4 bars at 100 BPM)')

print('== D: metronome')
print(f'      status {status.get("met_on")}')
a, b = ev['met_on'], ev['met_on_stop']
on = onsets(a, b, -50, 0.1)
fs = [freq(t) for t in on]
iv = np.diff(on)
print('      clicks at ' + ' '.join(f'{t - a:.4f}' for t in on))
print('      intervals ' + ' '.join(f'{v:.4f}' for v in iv) + ' s; frequencies ' + ' '.join(f'{f:.0f}' for f in fs) + ' Hz')
check(len(on) >= 7 and all(abs(v - 0.6) < 0.016 for v in iv), 'clicks every beat (0.600 s at 100 BPM)')
acc = [i for i, f in enumerate(fs) if f > 1600]
check(len(acc) >= 2 and acc[0] == 0 and all(i % 4 == 0 for i in acc) and all((i in acc) == (i % 4 == 0) for i in range(len(fs))),
      'the accent (2 kHz) falls on the first beat of every bar, including bar 1; 1.2 kHz on the others')
q = peak(ev['met_off'], ev['met_off_stop'])
print(f'      ENABLE Off, playing: peak {q:.1f} dBFS')
check(q < -100, 'metronome off: no clicks')

print(f'\nTRANSPORT FAILED: {len(fails)} check(s)' if fails else '\nTRANSPORT OK')
sys.exit(1 if fails else 0)
EOF
R=$?
echo "evidence: $OUT"
[ "$R" -eq 0 ] && [ "$ALIVE" -eq 0 ]
